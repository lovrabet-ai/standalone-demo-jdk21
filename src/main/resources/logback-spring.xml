    <!-- BFF脚本日志专用logger，additivity=false 防止日志向上传播到 root -->
    <logger name="BFF_SCRIPT_LOGGER" level="INFO" additivity="false">
        <!-- <appender-ref ref="BFF_SCRIPT_LOG_FILE" />-->
        <appender-ref ref="CONSOLE" />
    </logger>

<!-- Web请求日志专用logger，additivity=false 防止日志向上传播到 root -->
    <logger name="com.demoai.demo.web.filter.WebRequestLoggingFilter" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <!--<appender-ref ref="WEB_LOG_FILE" />-->
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <!--<appender-ref ref="MAIN_LOG_FILE" />-->
        <!--<appender-ref ref="ERROR_LOG_FILE" />-->
    </root>
</configuration>
